{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bluetooth Input Bridge",
  "version": "0.2.1",
  "identifier": "com.example.bluetoothinputbridge.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "蓝牙输入桥 · PC",
        "width": 900,
        "height": 650,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "SimpChinese": "gen/nsis/SimpChinese.nsh",
          "English": "gen/nsis/English.nsh"
        },
        "installerHooks": "gen/nsis/installer-hooks.nsh",
        "template": "generated-nsis/installer.nsi"
      }
    }
  }
}
