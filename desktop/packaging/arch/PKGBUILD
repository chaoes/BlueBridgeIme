# Maintainer: chao <chao@users.noreply.github.com>
# Build with: makepkg -f   (run as a normal user, inside this directory)
pkgname=bluetooth-input-bridge
pkgver=0.1.0
pkgrel=1
pkgdesc="Type on your phone, get the text on this computer over Bluetooth"
arch=('x86_64')
url="https://github.com/chaoes/BlueBridgeIme"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'librsvg' 'libevdev' 'openssl')
makedepends=('rust' 'cargo')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  cargo build --locked --release --bins --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$startdir/../.."
  install -Dm755 src-tauri/target/release/bluetooth-input-desktop \
    "$pkgdir/usr/bin/bluetooth-input-desktop"
  install -Dm755 src-tauri/target/release/bluetooth-input-bridge-service \
    "$pkgdir/usr/bin/bluetooth-input-bridge-service"
  install -Dm644 packaging/common/bluetooth-input-bridge.desktop \
    "$pkgdir/usr/share/applications/bluetooth-input-bridge.desktop"
  install -Dm644 packaging/common/bluetooth-input-bridge.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/bluetooth-input-bridge.svg"
  install -Dm644 "$startdir/../../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
